# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration (Supports TCP redis:// or Unix domain socket unix:///tmp/redis.sock)
REDIS_URL=redis://localhost:6379

# Rate Limiter Settings
# Maximum number of requests allowed per client in the sliding window
RATE_LIMIT_MAX_REQUESTS=5
# Time window duration in milliseconds (60000 ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Security & Reverse Proxy Settings
# Set to 'true', 'false', or specific IP/CIDR / hop count.
# WARNING: Only set to 'true' or configure hops when running behind a trusted reverse proxy (e.g. Nginx, Cloudflare).
# Never trust forwarded headers blindly in public-facing setups.
TRUST_PROXY=false
