{
  "name": "nosql-rate-limiter",
  "version": "1.0.0",
  "description": "Atomic Sliding Window Log Rate Limiter using Node.js, Express, and Redis 7 Sorted Sets",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit"
  },
  "keywords": [
    "rate-limiter",
    "redis",
    "sliding-window-log",
    "nosql",
    "express",
    "lua"
  ],
  "author": "Backend Engineer",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "testTimeout": 10000
  }
}
